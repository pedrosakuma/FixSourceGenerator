<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- DotnetDiagnostics.BenchmarkDotNet isn't published to nuget.org; its .nupkg is only
         attached to GitHub releases at https://github.com/pedrosakuma/dotnet-diagnostics/releases.
         benchmarks/FixSourceGenerator.Benchmarks/README.md and .github/workflows/ci.yml document
         how local-packages/ is populated (a gitignored folder feed, not committed). -->
    <add key="local-packages" value="local-packages" />
  </packageSources>
</configuration>
