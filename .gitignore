## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/

# Source Generated output
Generated

# Test results
[Tt]est[Rr]esult*/

# Rider
.idea/

# macOS
.DS_Store

# BenchmarkDotNet output
BenchmarkDotNet.Artifacts/

# Locally downloaded NuGet packages (e.g. dotnet-diagnostics-benchmarkdotnet, not on nuget.org)
local-packages/
