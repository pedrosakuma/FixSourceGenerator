<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>preview</LangVersion>
    <FixGeneratorNamespace>FixSourceGenerator.Benchmarks.Generated</FixGeneratorNamespace>
    <!-- Benchmarks must run Release/optimized code; BenchmarkDotNet also refuses to run
         a Debug build by default. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="dotnet-diagnostics-benchmarkdotnet" Version="0.24.0" />
    <PackageReference Include="QuickFIXn.Core" Version="1.14.1" />
    <PackageReference Include="QuickFIXn.FIX44" Version="1.14.1" />
  </ItemGroup>

  <!-- Reference the real source generator the same way a consumer project would (docs/USAGE.md
       §1) so the benchmarks exercise the actual generated reader/writer, not a hand-rolled stand-in. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FixSourceGenerator\FixSourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="Schema\FIX44-mini.xml" />
    <!-- Referencing the generator via ProjectReference (rather than the NuGet package) means
         buildTransitive/FixSourceGenerator.props isn't applied, so CompilerVisibleProperty must
         be declared here directly for FixGeneratorNamespace to reach the generator. -->
    <CompilerVisibleProperty Include="FixGeneratorNamespace" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Schema\FIX44-quickfixn-dictionary.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
