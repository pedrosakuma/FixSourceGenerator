<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(TemporalRuntimeTargetFramework)' == ''">net9.0</TargetFramework>
    <TargetFramework Condition="'$(TemporalRuntimeTargetFramework)' != ''">$(TemporalRuntimeTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TemporalRuntimeTargetFramework)' != ''">
    <OutputPath>bin/temporal-runtime/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/temporal-runtime/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TemporalRuntimeTargetFramework)' == ''">
    <PackageReference Include="QuickFIXn.Core" Version="1.14.1" />
    <PackageReference Include="QuickFIXn.FIX44" Version="1.14.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TemporalRuntimeTargetFramework)' != ''">
    <Compile Remove="**/*.cs" />
    <Compile Include="TestSupport.cs;TemporalReaderTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FixSourceGenerator\FixSourceGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../docs/USAGE.md" Link="TestData/USAGE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
